{
  "name": "flashcard-editor",
  "displayName": "Flashcard Editor",
  "description": "Study and browse/edit custom editors for .flashcard decks",
  "version": "0.1.0",
  "publisher": "Dev-DanielR",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dev-DanielR/flashcard-editor.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:flashcardEditor.study",
    "onCustomEditor:flashcardEditor.browse"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "flashcardEditor.study",
        "displayName": "Flashcard Study",
        "selector": [
          {
            "filenamePattern": "*.flashcard"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "flashcardEditor.browse",
        "displayName": "Flashcard Browse",
        "selector": [
          {
            "filenamePattern": "*.flashcard"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "flashcardEditor.openStudy",
        "title": "Open Study",
        "category": "Flashcard Editor",
        "icon": "$(book)"
      },
      {
        "command": "flashcardEditor.openBrowse",
        "title": "Open Browse",
        "category": "Flashcard Editor",
        "icon": "$(list-flat)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "flashcardEditor.openStudy",
          "when": "resourceExtname == .flashcard",
          "group": "navigation"
        },
        {
          "command": "flashcardEditor.openBrowse",
          "when": "resourceExtname == .flashcard",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "flashcard",
        "extensions": [
          ".flashcard"
        ],
        "aliases": [
          "Flashcard",
          "Flashcard Deck"
        ]
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "npm run compile && node --test out/cards/*.test.js",
    "package": "npm run compile && vsce package --out dist/flashcard-editor-0.1.0.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
